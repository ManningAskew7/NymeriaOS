# === Secrets & Environment ===
# Most env files are ignored by default. Specific files listed under the
# git-crypt exceptions below ARE tracked, but only as ciphertext via git-crypt.
.env
.env.*
!.env.example
!.env.docker.example
firebase-service-account.json
google_credentials.json
**/google_credentials.json.*
_prv_a-google-service-account.json
**/google_credentials.json
**/_prv_a-google-service-account.json
google_oauth_credentials.json
**/google_oauth_credentials.json
# Ad-hoc local secrets / key dumps
Keys.txt
**/Keys.txt
# Per-instance CLIProxy state — keep tracked files (source, compose, docs)
# but exclude per-machine secrets, configs, and runtime data:
CLIProxyAPI-main/auths/
!CLIProxyAPI-main/auths/.gitkeep
CLIProxyAPI-main/config.yaml
CLIProxyAPI-main/logs/
CLIProxyAPI-main/.env

# === Databases & User Data ===
*.db
*.db-wal
*.db-shm
*.sqlite
Nymeria/data/

# === RAG eval outputs & local embedding/reranker model caches (regenerable) ===
Nymeria/runs/
Nymeria/local_int8/
Nymeria/local_models/

# === Python ===
__pycache__/
*.pyc
*.pyo
*.egg-info/
*.egg
.venv/
venv/
# uv lockfile from ad-hoc local `uv` runs; dependency truth is
# pyproject.toml + requirements*.txt, no project flow consumes a repo lock.
uv.lock
dist/
build/
*.whl
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# === Node / Frontend ===
node_modules/
.svelte-kit/

# === Sibling repos (separate git history, separate GitHub remote) ===
nymeria-browser/

# === Rust / Tauri ===
target/
gen/schemas

# === Capacitor / Android ===
nymeria-mobile/android/app/build/
nymeria-mobile/android/build/
nymeria-mobile/android/.gradle/
nymeria-mobile/android/app/src/main/assets/public/
nymeria-mobile/android/app/src/main/assets/capacitor.config.json
*.keystore
!debug.keystore

# === WearOS Watch App ===
nymeria-watch/.gradle/
nymeria-watch/app/build/
nymeria-watch/build/
nymeria-watch/local.properties

# === IDE & OS ===
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# === Claude Code ===
# Host-local state stays ignored (worktrees/, agent-memory/, scheduled_tasks*,
# settings.local.json); the shareable project config below is tracked and is
# stripped from the public mirror by publish-prep (paths_to_remove: .claude/).
.claude/*
!.claude/README.md
!.claude/settings.json
!.claude/skills/
!.claude/agents/
!.claude/rules/
.claude-backup/
.playwright-mcp/

# === Cleanup artifacts ===
debug-artifacts/
*.local.txt

# === Project-specific exclusions ===
Plans-fixes.txt
nul
LangGraph/
default/
backups/
*.backup
*.log
Nymeria/planning/
strategy-notes/

# === Migration rollback snapshots — contain live OAuth tokens ===
# Keep these on disk for emergency rollback, never check them in.
CLIProxyAPI-main/migration-rollback-*/
CLIProxyAPI-main/auths-backup-20260418T054556Z/

# === Security audit (internal notes — keep out of public history) ===
SECURITY_AUDIT.md

# === Verification/testing artifacts ===
verify-output/
verify-*.png
verify-*.log
job-log.txt
notification-popover-fix.png
initial-load.png

# === Cloudflare tunnel connector assets written by `nymeria init` ===
# TUNNEL_TOKEN.txt is a live tunnel credential; for Docker hosting the wizard
# writes it inside the source checkout, so keep the whole dir untracked.
/Nymeria/cloudflared/

# === HexStrike sidecar (removed from the repo 2026-06-15) ===
# Pivoting from shipping MCP-server sidecars to native Nymeria @tool Python
# tools. The compose overlay and image-build dir are kept on disk untracked as
# a porting reference (allowed-tools.txt lists the curated tool subset).
/Nymeria/docker-compose.hexstrike.yml
/Nymeria/docker/hexstrike/

# === Operator-local compose override (never ship deployment-specific infra) ===
# docker compose auto-loads this file; each deployment may carry its own
# (e.g. the beta private-index sidecar on the reference host).
/Nymeria/docker-compose.override.yml

# === Agent scratch dirs (plans, logs, snapshots from in-flight work) ===
# Coding agents write throwaway working notes here per the repo workflow
# (e.g. a plan .md for a complex slice); these are never tracked.
/tmp/
/Nymeria/tmp
