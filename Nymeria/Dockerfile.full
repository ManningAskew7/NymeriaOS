# Nymeria Full Dockerfile - Kali Linux Workstation
# A complete development and security research environment
#
# Includes:
# - Kali Linux base with security tools
# - Python 3.11 + all Nymeria dependencies
# - Node.js + Claude Code CLI
# - Chromium + Playwright (BrowserAgent)
# - Git, build tools, development environment
#
# Build: docker build -f Dockerfile.full -t nymeria-full .
# Size: ~2-3GB

FROM kalilinux/kali-rolling

# Avoid prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Create the non-root user BEFORE any packages install. Debian allocates
# system uids/gids downward from 999, so a package in the apt layer below
# can otherwise claim 999 first and break this pin (bit for real on
# 2026-08-02 when a fresh, uncached base rebuild failed at groupadd).
# uid/gid pinned to 999 so the Docker named volumes (which carry forward
# this ownership from the image's chown below) line up with the runtime
# USER directive at the bottom of the file.
RUN groupadd -r -g 999 nymeria \
    && useradd -r -g nymeria -u 999 -m -s /bin/bash nymeria

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Python (use default Kali Python 3)
    python3 \
    python3-venv \
    python3-pip \
    python3-dev \
    # Node.js (for Claude Code)
    nodejs \
    npm \
    # Build tools
    build-essential \
    gcc \
    g++ \
    make \
    # Git and utilities
    git \
    curl \
    wget \
    vim \
    nano \
    htop \
    tmux \
    jq \
    unzip \
    ffmpeg \
    # Networking tools
    net-tools \
    iputils-ping \
    dnsutils \
    netcat-openbsd \
    # Browser dependencies for Playwright
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2t64 \
    libpango-1.0-0 \
    libcairo2 \
    # Kali security tools (commonly used)
    nmap \
    nikto \
    gobuster \
    dirb \
    sqlmap \
    whatweb \
    wpscan \
    hydra \
    john \
    hashcat \
    wordlists \
    seclists \
    # Clean up
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Set up Python symlinks
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3 1

# Create directories. The /app/data symlink gives Docker the same
# "data/ under the project root" layout as bare metal, so relative
# data/... paths from agent tools land on the /data volume instead of
# the read-only code tree (resource-filesystem-layout plan, slice 1).
# data/ is dockerignored, so the link cannot collide with copied code.
WORKDIR /app
RUN mkdir -p /data /workspace \
    && { [ -e /app/data ] || ln -s /data /app/data; } \
    && chown -R nymeria:nymeria /app /data /workspace

# Install Python dependencies as root first (for system packages)
COPY requirements*.txt ./
RUN pip3 install --no-cache-dir --break-system-packages -r requirements.txt \
    && if [ -f requirements-docker.txt ]; then \
        pip3 install --no-cache-dir --break-system-packages -r requirements-docker.txt; \
    fi

# Install uv (provides uvx) so Python-based MCP servers pasted by users
# (e.g. `uvx mcp-server-fetch`) can be spawned without extra setup.
RUN pip3 install --no-cache-dir --break-system-packages uv==0.11.7

# Install Playwright and browsers (as root for system-wide access)
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN pip3 install --no-cache-dir --break-system-packages playwright \
    && mkdir -p /ms-playwright \
    && playwright install chromium \
    && playwright install-deps chromium \
    && chmod -R 755 /ms-playwright

# Install Claude Code CLI globally
RUN npm install -g @anthropic-ai/claude-code || echo "Claude Code CLI installation skipped (may require auth)"

# Optional local-RAG extra: the granite embedder and Ettin reranker run
# in-process via sentence-transformers (which pulls torch). Off by default to
# keep the image lean; `nymeria init` writes NYMERIA_LOCAL_RAG=1 to .env.docker
# for a local embedder/reranker pick and docker-compose.yml passes it through
# as this build arg. CPU-only torch index on purpose: the default index would
# pull the multi-GB CUDA build. An already-built stack needs `up -d --build`
# once (plain `up -d` never rebuilds an existing image for a changed arg).
ARG NYMERIA_LOCAL_RAG=0
RUN if [ "$NYMERIA_LOCAL_RAG" = "1" ]; then \
        pip3 install --no-cache-dir --break-system-packages \
            --extra-index-url https://download.pytorch.org/whl/cpu \
            "sentence-transformers>=3.0.0"; \
    fi

# Copy application code
COPY --chown=nymeria:nymeria . .

# Environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV NYMERIA_DATA_DIR=/data
ENV NYMERIA_WORKSPACE_DIR=/workspace
ENV PATH="/usr/local/bin:$PATH"

# Drop privileges. All persistent writes target /data and /workspace which
# are owned by nymeria:nymeria (see chown above). bash_execute and shell-out
# tools run as uid 999 — nmap loses SYN-scan privileges (falls back to TCP
# connect), apt-get and writes to /etc/ fail. Intentional for production.
USER nymeria

# Expose ports
# 8000 - REST API
# 8001 - MCP Server (HTTP mode)
EXPOSE 8000 8001

# Default command - run API server
CMD ["python", "run.py", "api"]
