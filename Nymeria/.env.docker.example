# Nymeria Docker Environment Configuration
# Copy this file to .env.docker and fill in the required values

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# NYMERIA_API_KEY (deprecated, ignored by server). Authentication is done
# via per-user account tokens. On first boot, create the admin with:
#   python3 run.py users add owner@localhost --role admin --id default
# or just rely on the auto-bootstrap that writes data/BOOTSTRAP_TOKEN.txt.
# Paste the printed token into the desktop/mobile Setup Wizard. See
# docs/accounts.md.
#NYMERIA_API_KEY=

# Admin-role account token used by worker, bots, MCP, and service
# processes for per-user act-as calls. Once the backend is running, create it with:
#   docker exec nymeria-api python3 run.py users add bot-service@localhost --role admin --id bot-service
# and paste the printed token here. See docs/accounts.md.
NYMERIA_SERVICE_TOKEN=

# Account token hardening. Tokens expire automatically and each user has a
# bounded number of simultaneously active tokens.
# ACCOUNT_TOKEN_TTL_DAYS=90
# ACCOUNT_MAX_ACTIVE_TOKENS_PER_USER=10
# ACCOUNT_BOOTSTRAP_TOKEN_TTL_HOURS=24

# Local-execution tradeoffs. Docker deployments use the container as the
# primary sandbox; set stricter flags true/false here when publishing a
# multi-user deployment with a narrower tool surface.
# NYMERIA_WORKSPACE_DIR=/workspace
# NYMERIA_CONFINE_FILE_TO_WORKSPACE=false
# NYMERIA_ALLOW_SELF_EDIT=true
# NYMERIA_ALLOW_UNSANDBOXED_MCP_INSTALL=true
# NYMERIA_ENFORCE_MCP_STDIO_ALLOWLIST=false

# Claude Code bridge (admin-only `claude_code` tool). Nymeria in Docker drives
# Claude Code on the host via a runner: `python3 run.py claude-code-runner`.
# Start the runner on the host with a token, then set the URL+token here. See
# docs/agent-systems/claude-code-bridge.md. Unset = tool disabled.
# NYMERIA_CLAUDE_CODE_URL=http://host.docker.internal:8200
# NYMERIA_CLAUDE_CODE_TOKEN=          # same value the runner is started with
# NYMERIA_CLAUDE_CODE_ROOTS=/opt/NymeriaOS   # allowed working-dir roots
# NYMERIA_CLAUDE_CODE_MODEL=          # e.g. opus; empty = Claude Code default
# NYMERIA_CLAUDE_CODE_FALLBACK_MODEL= # fallback model when the primary is unavailable
# NYMERIA_CLAUDE_CODE_DEFAULT_MODE=dontAsk  # default/plan/acceptEdits/dontAsk/auto/bypass
# NYMERIA_CLAUDE_CODE_BARE=false      # true + ANTHROPIC_API_KEY for isolated API-key runs
# NYMERIA_CLAUDE_CODE_MAX_TURNS=      # cap ReAct turns per run; empty = no explicit cap
# NYMERIA_CLAUDE_CODE_MAX_BUDGET_USD= # per-run USD cap; empty = none (subscription bills $0)
# NYMERIA_CLAUDE_CODE_MAX_CONCURRENCY=2  # max concurrent host runs (bounds host memory)
# NYMERIA_CLAUDE_CODE_ALLOWED_MODELS=    # allowlist for per-thread model overrides; empty = accept any
# NYMERIA_CLAUDE_CODE_DISALLOWED_TOOLS=  # override the hard deny list (comma/os.pathsep)
# NYMERIA_CLAUDE_CODE_BLOCK_SECONDS=  # max inline wait before detaching; empty = derive from tool_timeout

# PostgreSQL Password (used by docker-compose)
POSTGRES_PASSWORD=your-secure-password-here

# Redis password (used by docker-compose and REDIS_URL)
# Generate a URL-safe value, for example: openssl rand -hex 32
REDIS_PASSWORD=your-secure-redis-password-here

# LLM Provider API Key (at least one is required)
# Uncomment and fill in the one you're using:
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
# GEMINI_API_KEY=           # Required for Gemini TTS and document extraction

# Semantic embeddings for skills and memory search.
# Keep this separate from OPENAI_API_KEY: when OPENAI_API_KEY is a CLIProxy
# gatekeeper key (cpx-*), it cannot call hosted embeddings.
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small  # must return 1536-dimensional vectors

# ============================================================================
# LLM CONFIGURATION
# ============================================================================

# LLM Provider: anthropic, openai, or openrouter
LLM_PROVIDER=anthropic

# Model to use (default shown)
LLM_MODEL=claude-sonnet-4-6

# Model tiers used by the /fast, /smart and /background commands and the
# "fast"/"smart"/"background" aliases (e.g. in spawn_thread). Each may be a
# model ID for the active provider, or provider:model to target a different
# provider with its own credentials (e.g. openai:gpt-4o-mini) so an outage on
# the primary provider does not also disable the tier. Leave unset for
# defaults: fast uses a provider-aware default, smart and background fall back
# to LLM_MODEL.
# LLM_FAST_MODEL=claude-haiku-4-5-20251001
# LLM_SMART_MODEL=
# Background/utility tier: powers the extraction_prompt step (fetch_url_nymeria
# and file_read) now, more background tasks later. A small LOCAL model works
# well here (no tool calling required). LLM_BACKGROUND_BASE_URL is an optional
# base-URL override (e.g. a local server or CLIProxy); blank inherits the
# resolved provider's base URL like fast/smart.
# LLM_BACKGROUND_MODEL=
# LLM_BACKGROUND_BASE_URL=

# Ordered fallback chain tried after the primary model exhausts retries.
# Comma-separated; entries may be model IDs or provider:model for any known
# provider (independent credentials per provider). Defaults to a Haiku fallback.
# LLM_FALLBACK_MODELS=anthropic:claude-haiku-4-5-20251001
# Seconds to keep an activated fallback pinned to a thread (0 disables).
# LLM_FALLBACK_HOLD_SECONDS=7200

# Temperature (0.0 to 2.0)
LLM_TEMPERATURE=1.0

# Override API base URL (e.g., CLIProxyAPI)
# Anthropic/Claude CLIProxy: no /v1 suffix; OpenAI/Codex CLIProxy: include /v1.
# LLM_BASE_URL=http://host.docker.internal:8317

# Maximum output tokens (model default if not set)
# LLM_MAX_TOKENS=8192

# Enable extended thinking/reasoning for compatible models
# LLM_EXTENDED_THINKING=false

# Reasoning effort for compatible models: low, medium, high
# LLM_REASONING_EFFORT=

# Use model-specific defaults for temperature/top_p/frequency_penalty
# LLM_USE_MODEL_DEFAULTS=false

# OpenAI provider API mode: responses (default) or chat_completions.
# chat_completions is a compatibility override and is not recommended if
# thinking is enabled.
# OPENAI_API_MODE=responses

# ============================================================================
# DATABASE CONFIGURATION (auto-configured in Docker)
# ============================================================================

# PostgreSQL settings (these are used by docker-compose)
POSTGRES_USER=nymeria
POSTGRES_DB=nymeria
# Note: POSTGRES_URI is auto-generated by docker-compose from these values

# Shared LangGraph checkpointer connection pool (postgres backend only).
# min = connections kept open, max = hard ceiling for the API process.
# Sized at process start; changes need `up -d` to recreate the container.
# POSTGRES_POOL_MIN_SIZE=1
# POSTGRES_POOL_MAX_SIZE=10

# Blocking-work executors in the API process. DEFAULT_* sizes the asyncio
# default executor (all to_thread blocking work); CHECKPOINT_* sizes the
# dedicated LangGraph checkpoint I/O pool (keep at or below
# POSTGRES_POOL_MAX_SIZE on postgres). Sized at process start.
# DEFAULT_EXECUTOR_MAX_WORKERS=32
# CHECKPOINT_EXECUTOR_MAX_WORKERS=8

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# Allowed CORS origins (comma-separated). The default allows local desktop
# development and the bundled web UI. For production or LAN access, add the
# exact frontend URLs. Wildcard origins are rejected because the API allows
# credentialed CORS requests.
CORS_ORIGINS=http://localhost:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost,http://localhost:8000

# ============================================================================
# API PORT
# ============================================================================

# Port to expose the API on (default: 8000). After Phase 4 hardening this
# is bound to 127.0.0.1 only; public traffic goes through Caddy on 443.
API_PORT=8000

# FastAPI Swagger/ReDoc/OpenAPI routes are disabled by default. Enable only in
# trusted local development; restart the API after changing this.
# NYMERIA_API_DOCS=false
# NYMERIA_DEBUG=false

# ============================================================================
# REVERSE PROXY (Caddy)
# ============================================================================

# Public hostname for the deployment. Caddy uses this for automatic
# Let's Encrypt TLS issuance. Leave commented (default ":80") if you are
# fronting Caddy with Cloudflare Tunnel or Tailscale Funnel and don't have
# a public DNS record pointed at this host.
# NYMERIA_HOSTNAME=nymeria.example.com

# Browser-reachable public API origin used for one-time credential setup
# links sent by chat bots AND for OAuth authorization-code redirects when
# the agent calls request_credential(kind="oauth"). Usually this matches
# NYMERIA_HOSTNAME with HTTPS. Desktop credential modals still work when
# this is unset, but OAuth from a bot will return missing_public_url unless
# the provider supports device-code (currently only Outlook).
# NYMERIA_PUBLIC_URL=https://nymeria.example.com

# Contact email for the Let's Encrypt account. Required if NYMERIA_HOSTNAME
# is a real domain; otherwise ignored.
# ACME_EMAIL=you@example.com

# ============================================================================
# USER PREFERENCES
# ============================================================================

# IANA timezone (e.g., America/New_York, Europe/London, Australia/Sydney)
# USER_TIMEZONE=UTC

# ============================================================================
# IN-APP PROBLEM REPORTS
# ============================================================================

# Destination for the desktop "Report problem" button (POST /report). The report
# (thread ID, last 10 messages, client info, optional description) is emailed
# here via the Outlook email tool, sent from your connected Outlook account. Use
# a dedicated inbox, not a personal one: reports carry other users' message
# content. If unset, the report endpoint returns 503 and emails no one.
# NYMERIA_ERROR_REPORT_EMAIL=reports@example.com

# ============================================================================
# CONTEXT MANAGEMENT
# ============================================================================

# Strategy: auto_compact (default), sliding_window (legacy), none
# CONTEXT_MANAGEMENT=auto_compact

# Compaction trigger mode: "tokens" (absolute input-token count, default) or "percentage" (of model context window)
# COMPACT_THRESHOLD_MODE=tokens

# Trigger compaction at this fraction of context window (0.05-0.95). Used when COMPACT_THRESHOLD_MODE=percentage.
# COMPACT_THRESHOLD=0.8

# Trigger compaction at this absolute input-token count (1000-2000000). Used when COMPACT_THRESHOLD_MODE=tokens.
# Value is clamped to the model's context window at runtime.
# COMPACT_THRESHOLD_TOKENS=200000

# Retry transient LLM stream failures before any model output is emitted
# LLM_STREAM_MAX_RETRIES=2
# LLM_STREAM_RETRY_INITIAL_DELAY=1.0
# LLM_STREAM_RETRY_MAX_DELAY=8.0

# Maximum characters stored for one tool result
# TOOL_OUTPUT_MAX_CHARS=100000

# Append server-measured [Duration: ...] to tool results the model sees
# TOOL_TIMING_IN_RESULTS=false

# Minimum messages before compaction is allowed (2-20)
# COMPACT_KEEP_MESSAGES=4

# Model for summarization (defaults to main model, can use cheaper model)
# COMPACT_MODEL=

# ============================================================================
# LOGGING
# ============================================================================

# Base log level: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# Debug profiles (comma-separated): llm, ticker, threads, checkpoints, triggers, tools
# LOG_PROFILES=

# Per-module overrides: module:LEVEL pairs (comma-separated)
# LOG_MODULES=nymeria.core.agent:DEBUG,nymeria.tools.bash:WARNING

# ============================================================================
# BROWSER TOOLS
# ============================================================================

# BROWSER_FORCE_FALLBACK=false
# BROWSER_HEADLESS=          # true/false; blank auto-detects Docker/headless Linux
# BROWSER_VERIFY_SSL is deprecated; TLS verification is always enforced

# ============================================================================
# SCHEDULER & AUTONOMY
# ============================================================================

# Seconds between ticker polls for scheduled tasks (default: 5)
TICKER_POLL_INTERVAL=5

# Enable/disable watchdog for TODO staleness monitoring
WATCHDOG_ENABLED=true

# Minutes between watchdog checks (default: 5)
WATCHDOG_INTERVAL_MINUTES=5

# Minutes without update before a TODO is considered stale (default: 20)
TODO_STALENESS_MINUTES=20

# Max concurrent autonomous tasks (0 = unlimited)
# MAX_CONCURRENT_AUTONOMOUS=5

# Hours to retain activity log entries (1-168)
# ACTIVITY_RETENTION_HOURS=12

# ============================================================================
# OPTIONAL: WEB SEARCH
# ============================================================================

# Perplexity API key for the web_search_perplexity tool (opt-in tool in the
# WEB_SEARCH_SERVICE_TOOLS group). The key can also be provided through the
# credential vault / in-app credential prompt, which takes precedence over this.
# PERPLEXITY_API_KEY=pplx-...

# Perplexity search model (default: sonar-pro)
# PERPLEXITY_SEARCH_MODEL=sonar-pro

# Tavily API key for the web_search_tavily tool (opt-in tool in the
# WEB_SEARCH_INTEGRATION_TOOLS group). The key can also be provided through the
# credential vault / in-app credential prompt, which takes precedence over this.
# Free tier: 1,000 credits/month. Get a key at https://tavily.com
# TAVILY_API_KEY=tvly-...

# Exa API key for the web_search_exa tool (opt-in tool in the
# WEB_SEARCH_INTEGRATION_TOOLS group). Neural/semantic retrieval. The key can
# also be provided through the credential vault / in-app credential prompt, which
# takes precedence over this. Free tier: 1,000 requests/month. Get a key at
# https://dashboard.exa.ai/api-keys
# EXA_API_KEY=exa-...

# Firecrawl API key for the web_search_firecrawl tool (opt-in tool in the
# WEB_SEARCH_INTEGRATION_TOOLS group). Snippet-only web search (does not scrape
# result pages). The key can also be provided through the credential vault /
# in-app credential prompt, which takes precedence over this. Free tier: 1,000
# credits/month (search costs 2 credits per 10 results). Get a key at
# https://www.firecrawl.dev/app/api-keys
# FIRECRAWL_API_KEY=fc-...

# Brave Search API key for the web_search_brave tool (opt-in tool in the
# WEB_SEARCH_INTEGRATION_TOOLS group). Ranked-source search over Brave's own
# independent index. The key can also be provided through the credential vault /
# in-app credential prompt, which takes precedence over this. Brave removed its
# free tier on 2026-02-12, so a paid Search plan is required (about $5 per 1,000
# queries, with a $5 monthly credit). Get a key at
# https://api-dashboard.search.brave.com/
# BRAVE_API_KEY=...

# SearXNG base URL for the web_search_searxng tool (opt-in tool in the
# WEB_SEARCH_INTEGRATION_TOOLS group). Keyless, self-hosted metasearch (queries
# DuckDuckGo, Brave, Google, Mojeek, Wikipedia, and more, merged into one ranked
# list). Run the bundled sidecar with the `search` compose profile:
#   docker compose --profile search --env-file .env.docker up -d searxng
# The default below points at that sidecar on the internal network; to use an
# external instance instead, set its full base URL. The instance MUST have JSON
# output enabled (search.formats includes "json"); the bundled sidecar already
# does (see ./searxng/settings.yml). The base URL can also come from the
# credential vault (provider "searxng", field "base_url"), which takes precedence.
SEARXNG_BASE_URL=http://searxng:8080
# Secret the bundled SearXNG sidecar uses to sign its web UI cookies. Change
# this for any non-local deployment.
SEARXNG_SECRET=nymeria-searxng-internal-change-me

# --- Image generation (IMAGE_GEN_INTEGRATION_TOOLS group) --------------------
# One opt-in tool per provider: image_gen_openai (gpt-image-2), image_gen_gemini
# (Nano Banana Pro), image_gen_flux (Black Forest Labs FLUX.2), and the budget
# aggregators image_gen_replicate / image_gen_fal (FLUX.1 schnell, Z-Image Turbo).
# Every key can also come from the credential vault / in-app credential prompt,
# which takes precedence over these env values.
#
# image_gen_openai uses OPENAI_API_KEY (above) and image_gen_gemini uses
# GEMINI_API_KEY (above). Note: when OPENAI_API_KEY is a CLIProxy gatekeeper
# value (cpx-*), it cannot call the real OpenAI image API, so supply a genuine
# OpenAI key through the credential vault for image_gen_openai.
#
# Black Forest Labs key for image_gen_flux. Get one at https://api.bfl.ai/
# BFL_API_KEY=...
# Replicate token for image_gen_replicate. Get one at https://replicate.com/account/api-tokens
# REPLICATE_API_KEY=r8_...
# fal.ai key for image_gen_fal. Get one at https://fal.ai/dashboard/keys
# FAL_API_KEY=...

# ============================================================================
# OPTIONAL: TELEGRAM INTEGRATION
# ============================================================================

# Get a bot token from @BotFather on Telegram
# TELEGRAM_BOT_TOKEN=1234567890:ABC...

# Default chat ID for notifications (get from @userinfobot)
# TELEGRAM_DEFAULT_CHAT_ID=123456789

# Public username of the Telegram bot, no leading '@'. Optional; when set,
# the desktop "Connect Telegram" wizard renders one-tap deep links of the
# form t.me/<username>?start=link_<code>. With it unset the wizard shows
# the raw /bind and /start commands the user types manually.
# TELEGRAM_BOT_USERNAME=NymeriaBot

# ============================================================================
# OPTIONAL: AT-REST SECRETS ENCRYPTION (credential vault)
# ============================================================================
# Symmetric Fernet key used to encrypt user-supplied secrets, including
# credential-vault API keys, OAuth access/refresh tokens, and BYO Telegram bot
# tokens, before storing them in accounts.db. Required for OAuth/device-code
# connection flows and the "Use my own bot" wizard.
#
# Generate a fresh key once with:
#   docker exec nymeria-api python3 -c "from cryptography.fernet import \
#     Fernet; print(Fernet.generate_key().decode())"
#
# This key is permanent; rotating it requires re-encrypting every stored
# secret. Back it up alongside (but separate from) the database; if you
# lose it, all stored ciphertexts become unrecoverable.
# NYMERIA_SECRETS_KEY=your-44-char-fernet-key-here-=

# ============================================================================
# OPTIONAL: DISCORD INTEGRATION
# ============================================================================

# Webhook URL for one-way notifications (Server Settings > Integrations > Webhooks)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Bot token for two-way communication (Discord Developer Portal > Bot > Token)
# Required to use the discord-bot service: docker compose --profile discord up -d
# DISCORD_BOT_TOKEN=...

# Discord connection mode: gateway (WebSocket, default) or webhook
# DISCORD_MODE=gateway

# Guild response behavior: mention (only @Nymeria, default) or all (every message)
# DISCORD_RESPOND_MODE=mention

# ============================================================================
# OPTIONAL: TWITCH INTEGRATION
# ============================================================================
# Twitch is not a docker-compose service in the current stack. Run it as a
# standalone process with `python3 run.py twitch-bot` after exporting
# NYMERIA_SERVICE_TOKEN and the settings below.
#
# Setup:
# 1. Create an app at https://dev.twitch.tv/console/apps
# 2. Set OAuth redirect URL to http://localhost:54545/oauth/callback
# 3. Create a Twitch account for the bot and /mod it in the target channel
# 4. Generate an access token with scopes: user:read:chat user:write:chat
#    user:bot moderator:manage:banned_users moderator:manage:chat_messages
# 5. Fill in the values below

# TWITCH_CLIENT_ID=your-app-client-id
# TWITCH_CLIENT_SECRET=your-app-client-secret
# TWITCH_BOT_ACCESS_TOKEN=oauth-access-token
# TWITCH_BOT_REFRESH_TOKEN=oauth-refresh-token
# TWITCH_BOT_USER_ID=bot-numeric-user-id

# Channel to join (required when the Twitch runtime is enabled)
# TWITCH_CHANNEL=channelname

# Optional initial thread prompt for first setup. Existing thread config wins.
# TWITCH_SYSTEM_PROMPT=You are an autonomous Twitch chat and moderation bot...

# Chat buffer size - max messages kept in memory (default: 500)
# TWITCH_BUFFER_SIZE=500

# Chat pulse - periodically evaluate chat and optionally comment
# TWITCH_PULSE_ENABLED=true
# TWITCH_PULSE_INTERVAL=300
# TWITCH_PULSE_MESSAGE_COUNT=100

# Messages to include as context with !ask commands (default: 50)
# TWITCH_COMMAND_CONTEXT_COUNT=50

# Response mode: command (only !commands, default)
# TWITCH_RESPOND_MODE=command

# ============================================================================
# OPTIONAL: SLACK INTEGRATION
# ============================================================================

# Webhook URL for notifications (Slack App > Incoming Webhooks)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Bot token for two-way communication (Slack App > OAuth & Permissions)
# SLACK_BOT_TOKEN=xoxb-...

# ============================================================================
# OPTIONAL: MICROSOFT TEAMS BOT INTEGRATION
# ============================================================================
# Hosted by the API service at /integrations/teams/webhook.
# Register this public HTTPS endpoint as the bot messaging endpoint in Azure.

# Bot Framework app ID and client secret
# TEAMS_BOT_APP_ID=00000000-0000-0000-0000-000000000000
# TEAMS_BOT_APP_PASSWORD=...

# Optional Azure tenant ID used during setup/documentation
# TEAMS_BOT_TENANT_ID=00000000-0000-0000-0000-000000000000

# Channel behavior: mention (default) or all
# TEAMS_BOT_RESPOND_MODE=mention

# Deprecated; Bot Framework bearer-token validation is always enforced
# TEAMS_BOT_VALIDATE_AUTH=true

# Show compact tool-call events in Teams replies
# TEAMS_BOT_SHOW_TOOL_EVENTS=false

# Bot Framework endpoints; override only for sovereign/special clouds
# TEAMS_BOT_TOKEN_URL=https://login.microsoftonline.com/botframework.com/oauth2/v2.0/token
# TEAMS_BOT_OPENID_CONFIG_URL=https://login.botframework.com/v1/.well-known/openidconfiguration

# ============================================================================
# OPTIONAL: WHATSAPP CLOUD API INTEGRATION
# ============================================================================
# Hosted by the API service at /integrations/whatsapp/webhook.
# Configure the public HTTPS API URL as the Meta webhook callback URL.

# Permanent WhatsApp Business Cloud access token
# WHATSAPP_ACCESS_TOKEN=EAAG...

# Optional WhatsApp Business Account ID for native WhatsApp tools
# WHATSAPP_BUSINESS_ACCOUNT_ID=123456789012345

# Sender Phone Number ID used for Cloud API replies
# WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Graph API base URL
# WHATSAPP_BASE_URL=https://graph.facebook.com/v19.0

# Token Meta sends during webhook challenge verification
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=choose-a-long-random-token

# Required: verifies X-Hub-Signature-256 webhook POSTs
# WHATSAPP_APP_SECRET=...

# Show compact tool-call events in WhatsApp replies
# WHATSAPP_SHOW_TOOL_EVENTS=false

# ============================================================================
# OPTIONAL: VOICE (TTS/STT)
# ============================================================================
# Enable voice endpoints (/voice/chat, /voice/tts, /voice/stt) and Telegram
# voice notes. Local voice runs in the speaches sidecar (CPU; serves both
# faster-whisper STT and Kokoro TTS):
#   docker compose --env-file .env.docker --profile voice up -d
# then pull the models once (see the compose comments for speaches-cli lines).
# SPEACHES_IMAGE=ghcr.io/speaches-ai/speaches:latest-cpu
# SPEACHES_PORT=8970  # published on 127.0.0.1 only
# The GPU-tier Qwen3-TTS sidecar (profile voice-gpu) must be digest-pinned:
# QWEN3_TTS_IMAGE=ghcr.io/groxaxo/qwen3-tts-openai-fastapi@sha256:<digest>
# TTS_PORT=8880       # published on 127.0.0.1 only

# TTS Provider: none (default), openai, kokoro (local), qwen3 (local GPU),
# gemini, cartesia, elevenlabs, edge (free, keyless)
# TTS_PROVIDER=none

# TTS Base URL. For kokoro/faster-whisper in Docker, point at the speaches
# sidecar (the init wizard writes this automatically): http://speaches:8000/v1
# Not used for Gemini, Cartesia, ElevenLabs, or Edge.
# TTS_BASE_URL=

# TTS API key (falls back to OPENAI_API_KEY; Gemini uses GEMINI_API_KEY;
# Cartesia and ElevenLabs require their own key here)
# TTS_API_KEY=

# TTS model name; defaults per provider when unset (OpenAI: gpt-4o-mini-tts,
# Cartesia: sonic-3.5, ElevenLabs: eleven_flash_v2_5,
# Gemini: gemini-3.1-flash-tts-preview, Qwen3: Qwen3-TTS-0.6B,
# kokoro via speaches: speaches-ai/Kokoro-82M-v1.0-ONNX)
# TTS_MODEL=

# TTS voice; defaults per provider when unset (OpenAI: nova, kokoro: af_heart,
# Gemini: Kore, Edge: en-US-AriaNeural, ElevenLabs: Rachel). Cartesia has no
# default: set a voice UUID from play.cartesia.ai.
# TTS_VOICE=

# TTS output format: mp3, wav, opus, aac (Gemini/Cartesia/Edge always MP3)
# TTS_OUTPUT_FORMAT=mp3

# TTS playback speed (0.25 to 4.0; Cartesia clamps to 0.6-1.5, ElevenLabs to
# 0.7-1.2; not applicable for Gemini)
# TTS_SPEED=1.0

# STT Provider: none (default), openai, groq, faster-whisper (local)
# STT_PROVIDER=none

# STT Base URL. For faster-whisper in Docker, point at the speaches sidecar
# (the init wizard writes this automatically): http://speaches:8000/v1
# STT_BASE_URL=

# STT API key (falls back to OPENAI_API_KEY; Groq also reads GROQ_API_KEY)
# STT_API_KEY=

# Groq API key (Groq STT at ~$0.04/audio-hour; shared with the Groq LLM provider)
# GROQ_API_KEY=

# STT model name; defaults per provider when unset (OpenAI:
# gpt-4o-mini-transcribe, Groq: whisper-large-v3-turbo,
# faster-whisper via speaches: Systran/faster-whisper-small)
# STT_MODEL=

# STT language hint (ISO 639-1, e.g., en, es, de)
# STT_LANGUAGE=

# ============================================================================
# OPTIONAL: CONTAINER RESOURCE LIMITS (Docker stack)
# ============================================================================
# The compose stack sets per-container memory/CPU/PID caps as a safety boundary
# (blast-radius containment for a compromised tool call) and, for the API, to
# survive memory spikes from tool subprocesses. Defaults suit a host with about
# 4 GB+ RAM; the caps are NOT auto-sized from host RAM yet (a cgroup-aware
# `nymeria init` sizing step is a planned follow-up). Tune per host:

# API container memory cap. The API runs the agent (the largest process), so on
# bigger hosts raise this for more headroom (e.g. 2560m on 8 GB, 4g on 16 GB).
# NYMERIA_API_MEM_LIMIT=2g

# API container memory+swap total. Must be >= NYMERIA_API_MEM_LIMIT; the excess
# is swap headroom so a spike slows (swaps) instead of an instant OOM kill. Only
# effective if the host has swap. Set equal to NYMERIA_API_MEM_LIMIT to give the
# container no swap.
# NYMERIA_API_MEMSWAP_LIMIT=3g

# Note: tool subprocesses (bash, claude_code, custom python tools, MCP servers)
# are spawned with a raised OOM score so the kernel evicts them before the API
# under memory pressure. That protection is hardware-agnostic and active
# regardless of these caps.
