# Nymeria Docker Environment Configuration
# Copy this file to .env.docker and fill in the required values

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# API Authentication Key (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
NYMERIA_API_KEY=your-api-key-here

# PostgreSQL Password (used by docker-compose)
POSTGRES_PASSWORD=your-secure-password-here

# LLM Provider API Key (at least one is required)
# Uncomment and fill in the one you're using:
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...

# ============================================================================
# LLM CONFIGURATION
# ============================================================================

# LLM Provider: anthropic, openai, or openrouter
LLM_PROVIDER=anthropic

# Model to use (default shown)
LLM_MODEL=claude-sonnet-4-20250514

# Temperature (0.0 to 2.0)
LLM_TEMPERATURE=1.0

# Override API base URL (e.g., for local proxy like CLIProxyAPI)
# LLM_BASE_URL=http://host.docker.internal:8317

# Maximum output tokens (model default if not set)
# LLM_MAX_TOKENS=8192

# Enable extended thinking/reasoning for compatible models
# LLM_EXTENDED_THINKING=false

# Reasoning effort for compatible models: low, medium, high
# LLM_REASONING_EFFORT=

# Use model-specific defaults for temperature/top_p/frequency_penalty
# LLM_USE_MODEL_DEFAULTS=false

# ============================================================================
# DATABASE CONFIGURATION (auto-configured in Docker)
# ============================================================================

# PostgreSQL settings (these are used by docker-compose)
POSTGRES_USER=nymeria
POSTGRES_DB=nymeria
# Note: POSTGRES_URI is auto-generated by docker-compose from these values

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# Allowed CORS origins (comma-separated, or * for all)
# For production, set this to your frontend URL(s):
# CORS_ORIGINS=http://localhost:1420,https://your-domain.com
CORS_ORIGINS=*

# ============================================================================
# API PORT
# ============================================================================

# Port to expose the API on (default: 8000)
API_PORT=8000

# ============================================================================
# USER PREFERENCES
# ============================================================================

# IANA timezone (e.g., America/New_York, Europe/London, Australia/Sydney)
# USER_TIMEZONE=Australia/Sydney

# ============================================================================
# CONTEXT MANAGEMENT
# ============================================================================

# Strategy: auto_compact (default), sliding_window (legacy), none
# CONTEXT_MANAGEMENT=auto_compact

# Trigger compaction at this percentage of context window (0.5-0.95)
# COMPACT_THRESHOLD=0.8

# Minimum messages before compaction is allowed (2-20)
# COMPACT_KEEP_MESSAGES=4

# Model for summarization (defaults to main model, can use cheaper model)
# COMPACT_MODEL=

# ============================================================================
# LOGGING
# ============================================================================

# Base log level: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# Debug profiles (comma-separated): llm, ticker, threads, checkpoints, triggers, tools
# LOG_PROFILES=

# Per-module overrides: module:LEVEL pairs (comma-separated)
# LOG_MODULES=nymeria.core.agent:DEBUG,nymeria.tools.bash:WARNING

# ============================================================================
# SCHEDULER & AUTONOMY
# ============================================================================

# Seconds between ticker polls for scheduled tasks (default: 5)
TICKER_POLL_INTERVAL=5

# Enable/disable watchdog for TODO staleness monitoring
WATCHDOG_ENABLED=true

# Minutes between watchdog checks (default: 5)
WATCHDOG_INTERVAL_MINUTES=5

# Minutes without update before a TODO is considered stale (default: 20)
TODO_STALENESS_MINUTES=20

# Max concurrent autonomous tasks (0 = unlimited)
# MAX_CONCURRENT_AUTONOMOUS=5

# Max self-invocations per user per hour (rate limiting)
# MAX_SELF_INVOKES_PER_HOUR=50

# Hours to retain activity log entries (1-168)
# ACTIVITY_RETENTION_HOURS=12

# ============================================================================
# OPTIONAL: WEB SEARCH
# ============================================================================

# Perplexity API key for web search functionality
# PERPLEXITY_API_KEY=pplx-...

# Perplexity search model (default: sonar-pro)
# PERPLEXITY_SEARCH_MODEL=sonar-pro

# ============================================================================
# OPTIONAL: WEBHOOK SECURITY
# ============================================================================

# Secret for validating incoming webhooks from messaging platforms
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# WEBHOOK_SECRET=your-webhook-secret-here

# ============================================================================
# OPTIONAL: TELEGRAM INTEGRATION
# ============================================================================

# Get a bot token from @BotFather on Telegram
# TELEGRAM_BOT_TOKEN=1234567890:ABC...

# Default chat ID for notifications (get from @userinfobot)
# TELEGRAM_DEFAULT_CHAT_ID=123456789

# ============================================================================
# OPTIONAL: DISCORD INTEGRATION
# ============================================================================

# Webhook URL for one-way notifications (Server Settings > Integrations > Webhooks)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Bot token for two-way communication (Discord Developer Portal > Bot > Token)
# Required to use the discord-bot service: docker compose --profile discord up -d
# DISCORD_BOT_TOKEN=...

# Discord connection mode: gateway (WebSocket, default) or webhook
# DISCORD_MODE=gateway

# Guild response behavior: mention (only @Nymeria, default) or all (every message)
# DISCORD_RESPOND_MODE=mention

# ============================================================================
# OPTIONAL: TWITCH INTEGRATION
# ============================================================================
# Start with: docker compose --profile twitch --env-file .env.docker up -d
#
# Setup:
# 1. Create an app at https://dev.twitch.tv/console/apps
# 2. Set OAuth redirect URL to http://localhost:54545/oauth/callback
# 3. Create a Twitch account for the bot and /mod it in the target channel
# 4. Generate an access token with scopes: user:read:chat user:write:chat
#    user:bot moderator:manage:banned_users moderator:manage:chat_messages
# 5. Fill in the values below

# TWITCH_CLIENT_ID=your-app-client-id
# TWITCH_CLIENT_SECRET=your-app-client-secret
# TWITCH_BOT_ACCESS_TOKEN=oauth-access-token
# TWITCH_BOT_REFRESH_TOKEN=oauth-refresh-token
# TWITCH_BOT_USER_ID=bot-numeric-user-id

# Channel to join (default: silk)
# TWITCH_CHANNEL=silk

# Chat buffer size — max messages kept in memory (default: 500)
# TWITCH_BUFFER_SIZE=500

# Chat pulse — periodically evaluate chat and optionally comment
# TWITCH_PULSE_ENABLED=true
# TWITCH_PULSE_INTERVAL=300
# TWITCH_PULSE_MESSAGE_COUNT=100

# Messages to include as context with !ask commands (default: 50)
# TWITCH_COMMAND_CONTEXT_COUNT=50

# Response mode: command (only !commands, default)
# TWITCH_RESPOND_MODE=command

# ============================================================================
# OPTIONAL: SLACK INTEGRATION
# ============================================================================

# Webhook URL for notifications (Slack App > Incoming Webhooks)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Bot token for two-way communication (Slack App > OAuth & Permissions)
# SLACK_BOT_TOKEN=xoxb-...

# ============================================================================
# OPTIONAL: VOICE (TTS/STT)
# ============================================================================
# Enable voice endpoints (/voice/chat, /voice/tts, /voice/stt)
# Start local voice services: docker compose --profile voice up -d

# TTS Provider: none (default), openai, qwen3
# TTS_PROVIDER=none

# TTS Base URL (defaults: OpenAI=https://api.openai.com/v1, Qwen3=http://qwen3-tts:8000/v1)
# TTS_BASE_URL=

# TTS API key (falls back to OPENAI_API_KEY if not set)
# TTS_API_KEY=

# TTS model name (OpenAI: tts-1-hd, Qwen3: Qwen3-TTS-0.6B)
# TTS_MODEL=tts-1-hd

# TTS voice (OpenAI: alloy/echo/fable/onyx/nova/shimmer, Qwen3: default)
# TTS_VOICE=nova

# TTS output format: mp3, wav, opus, aac
# TTS_OUTPUT_FORMAT=mp3

# TTS playback speed (0.25 to 4.0)
# TTS_SPEED=1.0

# STT Provider: none (default), openai, faster-whisper
# STT_PROVIDER=none

# STT Base URL (defaults: OpenAI=https://api.openai.com/v1, faster-whisper=http://faster-whisper:8000/v1)
# STT_BASE_URL=

# STT API key (falls back to OPENAI_API_KEY if not set)
# STT_API_KEY=

# STT model name (OpenAI: gpt-4o-mini-transcribe, faster-whisper: large-v3-turbo)
# STT_MODEL=gpt-4o-mini-transcribe

# STT language hint (ISO 639-1, e.g., en, es, de)
# STT_LANGUAGE=
