# Per-bot values for the `twitch-chatter` compose service (copy to
# .env.twitch-chatter, which is gitignored). The Twitch application
# (TWITCH_CLIENT_ID/SECRET), STT_*, and the service token come from
# .env.docker and CANNOT be set here: compose's `environment` block wins over
# this file for every key it lists. The role (chatter) and
# TWITCH_CHAT_COMMANDS=false are pinned the same way.
# Setup: docs/chat-apps/twitch-bot.md, "A second bot".

# The streamer to sit in. Change it and `docker compose --profile twitch-chatter
# --env-file .env.docker up -d twitch-chatter` to move the bot; the thread below
# follows it.
TWITCH_CHANNEL=streamer_login

# The viewer account's token: tools/twitch_auth.py url --role chatter, log in
# AS that account, `exchange CODE`; `validate` prints the numeric user id.
TWITCH_BOT_ACCESS_TOKEN=
TWITCH_BOT_REFRESH_TOKEN=
TWITCH_BOT_USER_ID=

# One roaming thread, driven as its own Nymeria account (create it first:
# docker exec nymeria-api python run.py users add twitch-chatter@localhost --id twitch-chatter).
# Keep the `twitch_` prefix on the thread id: that makes it a shared-channel
# thread the bot can drive as a non-admin account through the service token.
# Put the same Twitch tokens in that account's credential vault (provider
# `twitch`): a thread bound to a channel other than the api's TWITCH_CHANNEL
# refuses the deployment's credentials, so without the record the tools error
# instead of posting as the moderator account.
TWITCH_THREAD_ID=twitch_chatter
TWITCH_NYMERIA_USER_ID=twitch-chatter

# Pulse, listener, reaction check, wake (defaults shown; same semantics as the
# TWITCH_* reference in docs/configuration.md).
TWITCH_PULSE_ENABLED=true
TWITCH_PULSE_INTERVAL=300
TWITCH_PULSE_MIN_MESSAGES=10
TWITCH_LISTEN_ENABLED=false
TWITCH_LISTEN_WINDOW_SECONDS=12
TWITCH_LISTEN_WAKE_WORDS=
TWITCH_REACTION_CHECK_SECONDS=75
