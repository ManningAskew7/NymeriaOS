# Nymeria Slim Dockerfile - Thin Client Runtime
#
# Used by Docker services that call the Nymeria API over HTTP and do not own a
# NymeriaAgent instance. It intentionally omits Kali tools, Playwright browsers,
# Node.js, Claude Code CLI, and test dependencies.
#
# Build: docker build -f Dockerfile.slim -t nymeria-slim .

FROM python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive

# Minimal runtime utilities. Keep this list narrow; agent/tool executors use
# Dockerfile.full when they need the Kali/browser/CLI environment.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gcc \
    g++ \
    make \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN mkdir -p /data /workspace

COPY requirements*.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
    && if [ -f requirements-docker.txt ]; then \
        pip install --no-cache-dir -r requirements-docker.txt; \
    fi \
    && apt-get purge -y --auto-remove gcc g++ make \
    && rm -rf /var/lib/apt/lists/*

COPY . .

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV NYMERIA_DATA_DIR=/data
ENV NYMERIA_WORKSPACE_DIR=/workspace
ENV PATH="/usr/local/bin:$PATH"

# The concrete command is supplied by docker-compose.yml.
CMD ["python", "run.py", "watchdog"]
