/* First-run wizard theme: light-blue accents, white text, boxy borders.
   Seeded from the chat CLI palette so the family resemblance holds, without
   reusing the chat banner. Custom ASCII art slots in at #wizard-title later. */

Screen {
    background: #121620;
    color: #e8eaed;
}

#wizard-title {
    text-style: bold;
    color: #ffffff;
    padding: 1 2 0 2;
}

#wizard-step {
    color: #6b7280;
    padding: 0 2 1 2;
}

#wizard-note {
    color: #aab4c3;
    padding: 0 2 1 2;
}

#wizard-body {
    height: 1fr;
    padding: 0 2;
    /* A readable scrollbar: a visibly darker track with a lighter thumb, so it
       reads as a scrollbar (not an indistinct block) and signals that the step
       scrolls. The thumb brightens on hover/drag. */
    scrollbar-size-vertical: 1;
    scrollbar-background: #2a3140;
    scrollbar-background-hover: #2a3140;
    scrollbar-background-active: #2a3140;
    scrollbar-color: #5b6675;
    scrollbar-color-hover: #bbddfb;
    scrollbar-color-active: #bbddfb;
}

#choice-desc {
    color: #aab4c3;
    padding: 1 1 0 1;
}

/* Recommended embedder+reranker combos (embedder step) and the dynamic
   per-embedder pairing hint (reranker step): secondary text in a subtle box so
   the guidance reads as help, not a selectable option. */
#combo-hint,
#combo-rec {
    color: #aab4c3;
    background: #151a24;
    border: round #3a4251;
    height: auto;
    padding: 0 1;
    margin: 0 0 1 0;
}

#wizard-error {
    color: #fca5a5;
    height: auto;
    padding: 0 2;
}

#wizard-scroll-hint {
    color: #fcd34d;
    height: auto;
    padding: 0 2;
}

#wizard-hint {
    color: #6b7280;
    padding: 1 2;
    dock: bottom;
}

.field-label {
    color: #aab4c3;
    padding: 1 0 0 0;
}

.field-note {
    color: #aab4c3;
}

RadioSet,
SelectionList,
.radio-group {
    width: 1fr;
    height: auto;
    background: #151a24;
    border: round #3a4251;
    padding: 0 1;
}

RadioSet:focus,
SelectionList:focus,
.radio-group:focus-within {
    border: round #bbddfb;
}

/* Standalone radio buttons in a .radio-group render as a PLAIN list (no
   per-option box): strip the default ToggleButton border/background and the
   focus block-cursor, so the rows sit cleanly inside the group's single box.
   The focused (cursor) option is marked by bold + brighter text alone, and the
   filled white circle pins which option is selected. */
.radio-group > RadioButton {
    border: none;
    background: transparent;
    background-tint: black 0%;
    padding: 0 1;
    width: 1fr;
}

.radio-group > RadioButton:focus {
    border: none;
    background: transparent;
    background-tint: black 0%;
}

.radio-group > RadioButton:focus > .toggle--label {
    color: #ffffff !important;
    background: transparent !important;
    text-style: bold !important;
}

/* The radio indicator is a bare circle (CircleRadioButton renders the glyph),
   so paint it white over a transparent background: no blue box around the dot.
   Transparent (not a flat colour) keeps it blended under the focus tint too. */
RadioButton > .toggle--button {
    background: transparent;
    color: #aab4c3;
}

RadioButton.-on > .toggle--button {
    color: #ffffff;
}

/* No selection bar: the highlighted option is marked by bold + brighter text
   alone, not a background. Stock RadioSet tints `.toggle--label`; we override
   that to transparent and instead lift the selected row's text. The filled white
   circle (the dot follows the highlight) already pins which row is current, so
   bold-bright text reads clearly without a bar. Slightly dimmer when the set is
   blurred (e.g. the connection step's API-mode set while focus is elsewhere). */
RadioSet > RadioButton.-selected {
    background: transparent;
}

RadioSet > RadioButton.-selected > .toggle--label {
    background: transparent;
    color: #cdd6e3;
    text-style: bold;
}

RadioSet:focus > RadioButton.-selected > .toggle--label {
    background: transparent;
    color: #ffffff;
    text-style: bold;
}

SearchableList {
    width: 1fr;
    height: auto;
}

OptionList {
    width: 1fr;
    background: #151a24;
    border: round #3a4251;
    padding: 0 1;
}

OptionList:focus {
    border: round #bbddfb;
}

#model-hint {
    color: #aab4c3;
    padding: 1 0 0 0;
}

Input {
    border: tall #3a4251;
}

Input:focus {
    border: tall #bbddfb;
}

Button {
    margin: 1 1 0 0;
}

Button:focus {
    border: tall #bbddfb;
}

QuitConfirmScreen {
    align: center middle;
}

#quit-box {
    width: 60;
    height: auto;
    background: #151a24;
    border: round #bbddfb;
    padding: 1 2;
}

#quit-text {
    padding: 0 0 1 0;
}

#quit-buttons {
    height: auto;
}
