/* First-run wizard theme, styled after the chat CLI's Rich look: light
   lavender primary text, one light-blue accent (#bbddfb, the CLI status
   accent), dimmer lavender-grey secondary text, and square corners everywhere
   (solid borders, no rounded glyphs). Boxes are unfilled outlines, and all
   loose text starts at column 2, flush with the boxes' left edges. */

Screen {
    background: #121620;
    color: #dad4f0;
}

/* --- header: title + step counter on one line, ruled off from the body --- */

#wizard-header {
    height: auto;
    padding: 0 2;
    border-bottom: solid #3a4251;
}

#wizard-title {
    width: 1fr;
    text-style: bold;
    color: #ffffff;
}

#wizard-step {
    width: auto;
    color: #6b7280;
}

/* Secondary text is #c3bedd: clearly dimmer than the lavender primary text
   but bright enough to read comfortably (the original #aab4c3 was too dark). */

#wizard-note {
    color: #c3bedd;
    padding: 0 2;
}

#wizard-body {
    height: 1fr;
    padding: 0 2;
    /* A readable scrollbar: a visibly darker track with a lighter thumb, so it
       reads as a scrollbar (not an indistinct block) and signals that the step
       scrolls. The thumb brightens on hover/drag. */
    scrollbar-size-vertical: 1;
    scrollbar-background: #1a2030;
    scrollbar-background-hover: #1a2030;
    scrollbar-background-active: #1a2030;
    scrollbar-color: #3f4756;
    scrollbar-color-hover: #bbddfb;
    scrollbar-color-active: #bbddfb;
}

/* Hugs the option box above it: the description belongs to that box. */
#choice-desc {
    color: #c3bedd;
    padding: 0;
}

/* Welcome panel: the detected-environment report, framed like a Rich panel
   with the heading embedded in the border. */
#env-report {
    width: auto;
    height: auto;
    border: solid #3a4251;
    border-title-color: #bbddfb;
    padding: 0 2;
}

/* The reranker step's dynamic per-embedder pairing hint: secondary text in a
   quiet box so the guidance reads as help, not a selectable option. */
#combo-rec {
    color: #c3bedd;
    background: transparent;
    border: solid #2a3140;
    height: auto;
    padding: 0 1;
    margin: 0 0 1 0;
}

/* Inline help under the RAG key/retrieval fields. */
#key-status,
#retrieval-help {
    color: #c3bedd;
    height: auto;
    padding: 0;
}

#wizard-error {
    color: #fca5a5;
    height: auto;
    padding: 0 2;
}

#wizard-scroll-hint {
    height: auto;
    padding: 0 2;
}

/* Footer key bar: ruled off like the header; key names are accented in
   markup (see `hint_markup`), this grey is the fallback for plain text. */
#wizard-hint {
    color: #6b7280;
    height: auto;
    padding: 0 2;
    border-top: solid #2a3140;
    dock: bottom;
}

.field-label {
    color: #c3bedd;
    text-style: bold;
    padding: 1 0 0 0;
}

.field-note {
    color: #c3bedd;
    padding: 0;
}

/* A field-note that opens a new section gets a blank line above it. */
.section-note {
    color: #c3bedd;
    padding: 1 0 0 0;
}

/* Two-up grid of labeled inputs: halves the vertical footprint so the tuning
   steps fit a standard terminal without scrolling. */
.field-grid {
    layout: grid;
    grid-size: 2;
    grid-gutter: 0 2;
    grid-rows: auto;
    height: auto;
    width: 1fr;
}

.field-cell {
    height: auto;
    width: 1fr;
}

RadioSet,
SelectionList,
.radio-group {
    width: 1fr;
    height: auto;
    background: transparent;
    border: solid #3a4251;
    padding: 0 1;
}

RadioSet:focus,
SelectionList:focus,
.radio-group:focus-within {
    border: solid #bbddfb;
}

/* Standalone radio buttons in a .radio-group render as a PLAIN list (no
   per-option box): strip the default ToggleButton border/background and the
   focus block-cursor, so the rows sit cleanly inside the group's single box.
   The focused (cursor) option is marked by bold white text plus an accent
   circle; the filled circle pins which option is selected. */
.radio-group > RadioButton {
    border: none;
    background: transparent;
    background-tint: black 0%;
    padding: 0 1;
    width: 1fr;
}

.radio-group > RadioButton:focus {
    border: none;
    background: transparent;
    background-tint: black 0%;
}

.radio-group > RadioButton:focus > .toggle--label {
    color: #ffffff !important;
    background: transparent !important;
    text-style: bold !important;
}

/* The radio indicator is a bare circle (CircleRadioButton renders the glyph),
   painted over a transparent background: no box around the dot. Grey when
   idle, white when selected, accent on the focused (cursor) row. */
RadioButton > .toggle--button {
    background: transparent;
    color: #6b7280;
}

RadioButton.-on > .toggle--button {
    color: #ffffff;
}

.radio-group > RadioButton:focus > .toggle--button {
    color: #bbddfb;
}

/* Disabled (greyed-out) choices: visible but clearly inert. Textual already
   makes them unfocusable; this dims the text and glyph (the app-level
   disabled opacity fade still composes on top). */
.radio-group > RadioButton:disabled > .toggle--label {
    color: #5a6372;
}

.radio-group > RadioButton:disabled > .toggle--button {
    color: #5a6372;
}

/* No selection bar: the highlighted option is marked by bold + brighter text
   alone, not a background. Stock RadioSet tints `.toggle--label`; we override
   that to transparent and instead lift the selected row's text. The filled
   circle (the dot follows the highlight) already pins which row is current, so
   bold-bright text reads clearly without a bar. Slightly dimmer when the set is
   blurred (e.g. the connection step's API-mode set while focus is elsewhere). */
RadioSet > RadioButton.-selected {
    background: transparent;
}

RadioSet > RadioButton.-selected > .toggle--label {
    background: transparent;
    color: #cfc9e8;
    text-style: bold;
}

RadioSet:focus > RadioButton.-selected > .toggle--label {
    background: transparent;
    color: #ffffff;
    text-style: bold;
}

SearchableList {
    width: 1fr;
    height: auto;
}

OptionList {
    width: 1fr;
    background: transparent;
    border: solid #3a4251;
    padding: 0 1;
    scrollbar-size-vertical: 1;
    scrollbar-background: #1a2030;
    scrollbar-background-hover: #1a2030;
    scrollbar-background-active: #1a2030;
    scrollbar-color: #3f4756;
    scrollbar-color-hover: #bbddfb;
    scrollbar-color-active: #bbddfb;
}

OptionList:focus {
    border: solid #bbddfb;
}

/* List highlight: one quiet desaturated-blue bar (instead of the stock bright
   ANSI-blue block cursor), shared by the pickers and the checkbox lists. */
OptionList > .option-list--option-highlighted {
    background: #232e44;
    color: #ffffff;
}

OptionList:focus > .option-list--option-highlighted {
    background: #283450;
    color: #ffffff;
}

/* Checkbox glyphs in multi-select lists: a dark square with an accent X. */
SelectionList > .selection-list--button {
    background: #2a3140;
    color: #2a3140;
}

SelectionList > .selection-list--button-highlighted {
    background: #3a4251;
    color: #3a4251;
}

SelectionList > .selection-list--button-selected {
    background: #2a3140;
    color: #bbddfb;
}

SelectionList > .selection-list--button-selected-highlighted {
    background: #3a4251;
    color: #bbddfb;
}

#model-hint,
#provider-note {
    color: #c3bedd;
    height: auto;
    padding: 1 0 0 0;
}

/* Picker lists size to the terminal in code (SearchableList._fit_list): a CSS
   vh max-height is not resolved when the parent measures its auto height. */

Input {
    background: #151a24;
    border: solid #3a4251;
    padding: 0 1;
}

Input:focus {
    border: solid #bbddfb;
}

Input > .input--placeholder {
    color: #6b7280;
}

Button {
    margin: 1 1 0 0;
    border: solid #3a4251;
    background: #1a2230;
    color: #dad4f0;
    text-style: none;
}

Button:focus {
    border: solid #bbddfb;
    background: #1a2230;
    color: #ffffff;
    text-style: bold;
}

Button:hover {
    border: solid #bbddfb;
    background: #1a2230;
}

Button.-error {
    background: #2c151a;
    border: solid #7f3540;
    color: #fca5a5;
}

Button.-error:focus,
Button.-error:hover {
    border: solid #fca5a5;
    background: #2c151a;
    color: #fca5a5;
}

QuitConfirmScreen {
    align: center middle;
}

#quit-box {
    width: 60;
    height: auto;
    background: #151a24;
    border: solid #bbddfb;
    padding: 1 2;
}

#quit-text {
    padding: 0 0 1 0;
}

#quit-buttons {
    height: auto;
}
