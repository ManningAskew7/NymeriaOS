/* First-run wizard theme: light-blue accents, white text, boxy borders.
   Seeded from the chat CLI palette so the family resemblance holds, without
   reusing the chat banner. Custom ASCII art slots in at #wizard-title later. */

Screen {
    background: #121620;
    color: #e8eaed;
}

#wizard-title {
    text-style: bold;
    color: #ffffff;
    padding: 1 2 0 2;
}

#wizard-step {
    color: #6b7280;
    padding: 0 2 1 2;
}

#wizard-note {
    color: #aab4c3;
    padding: 0 2 1 2;
}

#wizard-body {
    height: 1fr;
    padding: 0 2;
}

#choice-desc {
    color: #aab4c3;
    padding: 1 1 0 1;
}

#wizard-error {
    color: #fca5a5;
    height: auto;
    padding: 0 2;
}

#wizard-hint {
    color: #6b7280;
    padding: 1 2;
    dock: bottom;
}

.field-label {
    color: #aab4c3;
    padding: 1 0 0 0;
}

RadioSet,
SelectionList {
    width: 1fr;
    background: #151a24;
    border: round #3a4251;
    padding: 0 1;
}

RadioSet:focus,
SelectionList:focus {
    border: round #bbddfb;
}

/* The radio indicator is a bare circle (CircleRadioButton renders the glyph),
   so paint it white over a transparent background: no blue box around the dot.
   Transparent (not a flat colour) keeps it blended under the focus tint too. */
RadioButton > .toggle--button {
    background: transparent;
    color: #aab4c3;
}

RadioButton.-on > .toggle--button {
    color: #ffffff;
}

/* No selection bar: the highlighted option is marked by bold + brighter text
   alone, not a background. Stock RadioSet tints `.toggle--label`; we override
   that to transparent and instead lift the selected row's text. The filled white
   circle (the dot follows the highlight) already pins which row is current, so
   bold-bright text reads clearly without a bar. Slightly dimmer when the set is
   blurred (e.g. the connection step's API-mode set while focus is elsewhere). */
RadioSet > RadioButton.-selected {
    background: transparent;
}

RadioSet > RadioButton.-selected > .toggle--label {
    background: transparent;
    color: #cdd6e3;
    text-style: bold;
}

RadioSet:focus > RadioButton.-selected > .toggle--label {
    background: transparent;
    color: #ffffff;
    text-style: bold;
}

SearchableList {
    width: 1fr;
    height: auto;
}

OptionList {
    width: 1fr;
    background: #151a24;
    border: round #3a4251;
    padding: 0 1;
}

OptionList:focus {
    border: round #bbddfb;
}

#model-hint {
    color: #aab4c3;
    padding: 1 0 0 0;
}

Input {
    border: tall #3a4251;
}

Input:focus {
    border: tall #bbddfb;
}

Button {
    margin: 1 1 0 0;
}

Button:focus {
    border: tall #bbddfb;
}

QuitConfirmScreen {
    align: center middle;
}

#quit-box {
    width: 60;
    height: auto;
    background: #151a24;
    border: round #bbddfb;
    padding: 1 2;
}

#quit-text {
    padding: 0 0 1 0;
}

#quit-buttons {
    height: auto;
}
